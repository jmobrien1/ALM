# No-cache for HTML/JSON; allow PDFs/CSS/JS to cache normally
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Force old path to new path (bypass any stale asset)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} ^/marketplace\.html$ [NC]
  RewriteRule ^marketplace\.html$ /market.html?v=4 [R=301,L]
</IfModule>
